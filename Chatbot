import com.example.T4.application.processing.model.CvDocument;
import com.example.T4.application.processing.repository.CvDocumentRepository;
import com.example.T4.application.processing.service.StorageService;
import org.springframework.core.io.Resource;

private final CvDocumentRepository cvDocumentRepository;
private final StorageService storageService;

@Override
public String chatWithCandidate(UUID candidateId, String message) {

    // 1. Find the candidate
    Candidate candidate = candidateRepository.findById(candidateId)
            .orElseThrow(() ->
                    ResourceNotFoundException.of("Candidate", candidateId)
            );

    // 2. Get the CV document ID stored on the candidate
    String cvDocumentId = candidate.getCvDocumentId();

    if (cvDocumentId == null || cvDocumentId.isBlank()) {
        throw new IllegalStateException(
                "Candidate does not have a CV document attached"
        );
    }

    // 3. Candidate stores cvDocumentId as String,
    // but CvDocumentRepository uses UUID
    UUID documentId = UUID.fromString(cvDocumentId);

    // 4. Find the CvDocument database record
    CvDocument document = cvDocumentRepository.findById(documentId)
            .orElseThrow(() ->
                    ResourceNotFoundException.of("CvDocument", documentId)
            );

    // 5. Get the real storage path
    String filePath = document.getFilePath();

    // 6. Load the CV from the existing storage service
    Resource cvResource = storageService.loadAsResource(filePath);

    // Temporary response just to prove retrieval works
    return "Candidate CV loaded successfully: "
            + cvResource.getFilename()
            + " | Question: "
            + message;
}


UUID documentId = candidate.getCvDocumentId();

if (documentId == null) {
    throw new IllegalStateException(
        "Candidate does not have a CV document attached"
    );
}



